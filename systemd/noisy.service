[Unit]
Description=Noisy HTTP and HTTPS traffic crawler
After=network-online.target
Wants=network-online.target

[Service]
User=noisy
WorkingDirectory=/opt/noisy
ExecStart=/opt/noisy/noisy --config /opt/noisy/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
